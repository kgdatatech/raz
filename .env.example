# Anthropic — required for all agent roles
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# GitHub — required for repo syncing, issue fetching, and PR creation
# Needs: repo, read:org, workflow scopes
GITHUB_TOKEN=

# GitHub webhook secret — required for verifying webhook payloads
# Must match the secret set in your GitHub repo Settings → Webhooks
GITHUB_WEBHOOK_SECRET=

# Legacy startup default. After boot, use the dashboard runner toggle.
# Set to "cc" to seed Claude Code as the initial server-side runner.
RAZ_RUNNER=

# Optional: require this token in x-raz-config-token for /api/config writes.
RAZ_CONFIG_TOKEN=

# Optional but strongly recommended when the app is reachable from outside
# localhost (e.g. tunneled for GitHub webhooks). When set, every route except
# /api/webhook/github, /api/health, and the login flow requires this token —
# via "Authorization: Bearer", "x-raz-token", or the /login page (cookie).
# Leave empty for purely local use: everything works without auth.
RAZ_API_TOKEN=

# Optional: override Codex CLI command used by the codex runner.
RAZ_CODEX_COMMAND=
RAZ_CODEX_MODEL=
